// Rendered to wrangler.jsonc by tooling/wire/render.mjs (deploy-time wiring).
// Resource IDs are NEVER committed: @@wiring(<component>/<env>:<key>)@@ tokens are
// resolved from the workspace's orun secrets at deploy time (wire-live) or from the
// committed wiring.fixture.json for offline dry-runs (wire-fixture).
//
// The R2 binding resolves by bucket NAME, which is deterministic per environment
// (infra/terraform/cloudflare-r2 creates exactly these), so it needs no wiring token.
{
  "name": "grantwell-grant-worker",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "minify": false,
  "vars": {
    "ENVIRONMENT": "local"
  },
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "dev"
      }
    },
    "stage": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "stage"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "grantwell-stage",
          "database_id": "@@wiring(cloudflare-d1/stage:d1_database_id)@@"
        }
      ],
      "r2_buckets": [
        {
          "binding": "GRANT_DOCS",
          "bucket_name": "grantwell-award-letters-stage"
        }
      ],
      "services": [
        {
          "binding": "MEMBERSHIP_WORKER",
          "service": "grantwell-membership-worker-stage"
        },
        {
          "binding": "POLICY_WORKER",
          "service": "grantwell-policy-worker-stage"
        },
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "grantwell-notifications-worker-stage"
        }
      ]
    },
    "prod": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "prod"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "grantwell-prod",
          "database_id": "@@wiring(cloudflare-d1/prod:d1_database_id)@@"
        }
      ],
      "r2_buckets": [
        {
          "binding": "GRANT_DOCS",
          "bucket_name": "grantwell-award-letters-prod"
        }
      ],
      "services": [
        {
          "binding": "MEMBERSHIP_WORKER",
          "service": "grantwell-membership-worker-prod"
        },
        {
          "binding": "POLICY_WORKER",
          "service": "grantwell-policy-worker-prod"
        },
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "grantwell-notifications-worker-prod"
        }
      ]
    }
  }
}
